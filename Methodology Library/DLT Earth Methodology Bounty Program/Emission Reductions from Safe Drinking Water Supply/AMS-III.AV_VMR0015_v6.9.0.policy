              {
                "id": "e71c3d20-9386-4616-a5f3-e4094d68b40b",
                "blockType": "customLogicBlock",
                "defaultActive": true,
                "permissions": [
                  "STANDARD_REGISTRY",
                  "PROJECTDEVELOPER",
                  "OWNER"
                ],
                "uiMetaData": {
                  "title": "ER Gate Tolerance Check",
                  "description": "Coerces string-typed numeric KPIs to Number(), enforces ERy>0 / vcuQuantity>0 / bufferVcuQuantity\u22650. Validates VVB multi-sig (Hedera DID format, \u226430 days old, no duplicates, no rejections, reputation-weighted approval sum \u22651.5). Validates OWNER token confirmation (ownerConfirmation=true, confirmedAmount=vcuQuantity \u00b10.001, \u226424 h fresh). On PASS, fires parallel events to mintvcu (95%) and mintbuffer (5%)"
                },
                "onErrorAction": "no-action",
                "selectedScriptLanguage": "JAVASCRIPT",
                "expression": "function gate() {\n  function csOf(d) {\n    if (!d || typeof d !== 'object') return null;\n    var doc = d.document || d;\n    if (doc && doc.credentialSubject) {\n      var cs = doc.credentialSubject;\n      if (Array.isArray(cs) && cs.length) return cs[0];\n      if (typeof cs === 'object') return cs;\n    }\n    if (doc && doc.policyId && doc['@context']) return doc;\n    return null;\n  }\n  function csWithDocOf(d) {\n    if (!d || typeof d !== 'object') return null;\n    var cs = csOf(d);\n    if (!cs) return null;\n    var doc = d.document || d;\n    return { cs: cs, issuer: doc.issuer || cs.issuer || null, owner: d.owner || null };\n  }\n  function findBySchema(iri) {\n    var pool = (typeof documents !== 'undefined' && documents) ? documents : [];\n    if (!Array.isArray(pool)) pool = [pool];\n    for (var i = 0; i < pool.length; i++) {\n      var w = csWithDocOf(pool[i]);\n      if (!w) continue;\n      var t = w.cs.type || '';\n      var ctx = w.cs['@context'] || (pool[i].document && pool[i].document['@context']) || '';\n      var ctxStr = Array.isArray(ctx) ? ctx.join('|') : String(ctx);\n      if (t === iri || t.indexOf(iri) >= 0 || ctxStr.indexOf(iri) >= 0) return w;\n    }\n    return null;\n  }\n  function num(v, n) {\n    if (v === undefined || v === null || v === '')\n      throw new Error('ergate: missing ' + n);\n    var x = Number(v);\n    if (!isFinite(x)) throw new Error('ergate: non-numeric ' + n);\n    return x;\n  }\n  function parseDate(s) {\n    if (!s) return null;\n    var t = Date.parse(s);\n    return isFinite(t) ? new Date(t) : null;\n  }\n\n  var d = document || {};\n\n  // \u2500\u2500 PHASE 1: numeric guards on calcengine output \u2500\u2500\n  var ERy = num(d.netEmissionReductionsTCO2e, 'netEmissionReductionsTCO2e');\n  var vcu = num(d.vcuQuantity, 'vcuQuantity');\n  var buf = num(d.bufferVcuQuantity, 'bufferVcuQuantity');\n  if (ERy <= 0) throw new Error('ergate: ERy must be > 0 (got '+ERy+')');\n  if (vcu <= 0) throw new Error('ergate: vcuQuantity must be > 0');\n  if (buf <  0) throw new Error('ergate: bufferVcuQuantity must be >= 0');\n  if (Math.abs((vcu + buf) - ERy) > 0.05)\n    throw new Error('ergate: vcuQuantity + buffer must equal ERy (got '+(vcu+buf)+' vs '+ERy+')');\n\n  // \u2500\u2500 PHASE 2: VVB validation + verification (+ DID INDEPENDENCE) \u2500\u2500\n  var VAL_IRI = '#d415d74f-12b3-45d4-88d0-bcce8a8ebf47&1.1.6';\n  var VER_IRI = '#51bfeb38-3e08-4b7c-9dc4-f942e2a0f2a0&1.1.6';\n  var OC_IRI  = '#7889d742-09d1-473c-aa76-0b92262e7d9f&1.1.0';\n  var WQ_IRI  = '#88a1a1e1-de73-4a77-b63d-1a1a493a8933&1.1.0';\n  var REG_IRI = '#18bf0b02-27d1-4551-ac92-f0c03718620c&1.1.0';\n  var MON_IRI = '#f23a8b6b-1334-4e8b-96b5-05923eeed8d5&1.1.0';\n\n  var valW = findBySchema(VAL_IRI);\n  var verW = findBySchema(VER_IRI);\n  if (!valW) throw new Error('ergate: no VVB Validation Report found in documents[]');\n  if (!verW) throw new Error('ergate: no VVB Verification Report found in documents[]');\n  var val = valW.cs, ver = verW.cs;\n  var valStatus = (val.validationstatus || '').toString().toLowerCase();\n  var verStatus = (ver.verificationstatus || '').toString().toLowerCase();\n  if (valStatus !== 'approved')\n    throw new Error('ergate: validationstatus must be \"approved\" (got \"'+val.validationstatus+'\")');\n  if (verStatus !== 'approved')\n    throw new Error('ergate: verificationstatus must be \"approved\" (got \"'+ver.verificationstatus+'\")');\n\n  // VVB DID INDEPENDENCE \u2014 validator must not equal verifier\n  var valIssuer = valW.issuer || val.issuer || valW.owner;\n  var verIssuer = verW.issuer || ver.issuer || verW.owner;\n  if (!valIssuer || !verIssuer)\n    throw new Error('ergate: VVB issuer DID missing on validation or verification report');\n  // DRY_RUN_MODE escape: when reg.dryRunMode === true, skip independence (testnet solo dev only).\n  // Real pilots leave dryRunMode unset \u2192 strict enforcement.\n  var regWForMode = findBySchema(REG_IRI);\n  var dryRunMode = regWForMode && regWForMode.cs && (regWForMode.cs.dryRunMode === true || regWForMode.cs.dryRunMode === 'true');\n  var vvbIndependenceEnforced = true;\n  if (valIssuer === verIssuer) {\n    if (dryRunMode) {\n      vvbIndependenceEnforced = false;\n    } else {\n      throw new Error('ergate: VVB independence violated \u2014 validator and verifier issuer DIDs must differ (got \"'+valIssuer+'\" for both). Set Project Registration dryRunMode=true to skip in solo testnet dry runs.');\n    }\n  }\n\n  // \u2500\u2500 PHASE 3: Water Quality microbiological safety attestation (\u00a75.3 m parameter req iii) \u2500\u2500\n  var wqW = findBySchema(WQ_IRI);\n  if (!wqW) throw new Error('ergate: no Water Quality Survey (v1.2.0) found \u2014 microbiological safety attestation required');\n  var wq = wqW.cs;\n  var microConfirmed = (wq.microSafetyConfirmed === true || wq.microSafetyConfirmed === 'true');\n  if (!microConfirmed)\n    throw new Error('ergate: microSafetyConfirmed must be true on Water Quality Survey');\n  if (!wq.microSafetyMethod)\n    throw new Error('ergate: microSafetyMethod required on Water Quality Survey');\n  if (!wq.microSafetyDate)\n    throw new Error('ergate: microSafetyDate required on Water Quality Survey');\n\n  // \u2500\u2500 PHASE 4: Owner anti-rug confirmation + 24h freshness \u2500\u2500\n  var ocW = findBySchema(OC_IRI);\n  if (!ocW) throw new Error('ergate: no Owner Confirmation found');\n  var oc = ocW.cs;\n  if (oc.ownerConfirmation !== true && oc.ownerConfirmation !== 'true')\n    throw new Error('ergate: ownerConfirmation must be true');\n  var confAmt = num(oc.confirmedAmount, 'confirmedAmount');\n  if (Math.abs(confAmt - vcu) > 0.01)\n    throw new Error('ergate: confirmedAmount ('+confAmt+') must equal vcuQuantity ('+vcu+')');\n\n  // 24h freshness: confirmation must be within 24h of monitoring period end (deterministic \u2014 no wall clock)\n  var monW = findBySchema(MON_IRI);\n  var monPeriodEnd = (monW && monW.cs && (monW.cs.monitoringPeriodEnd || monW.cs.periodEnd)) || d.calcedAtMonitoringPeriodEnd;\n  var ocAt = oc.confirmedAt || oc.signedAt || oc.timestamp;\n  var ocDate = parseDate(ocAt);\n  var monDate = parseDate(monPeriodEnd);\n  if (monDate && ocDate) {\n    var diffH = Math.abs(ocDate - monDate) / 3600000;\n    if (diffH > 24)\n      throw new Error('ergate: ownerConfirmation must be within 24h of monitoringPeriodEnd (diff='+diffH.toFixed(1)+'h)');\n  } else if (!ocDate) {\n    throw new Error('ergate: ownerConfirmation timestamp (confirmedAt) required');\n  }\n\n  // \u2500\u2500 PHASE 5: Crediting period boundary \u2500\u2500\n  var regW = findBySchema(REG_IRI);\n  if (!regW) throw new Error('ergate: no Project Registration (v1.2.0) found');\n  var reg = regW.cs;\n  var cpStart = parseDate(reg.creditingPeriodStart);\n  var cpEnd   = parseDate(reg.creditingPeriodEnd);\n  if (!cpStart || !cpEnd)\n    throw new Error('ergate: Project Registration must declare creditingPeriodStart and creditingPeriodEnd');\n  if (cpEnd <= cpStart)\n    throw new Error('ergate: creditingPeriodEnd must be after creditingPeriodStart');\n  // VMR0015 caps crediting period at 7 years renewable (max 21) or 10 years fixed\n  var cpYears = (cpEnd - cpStart) / (365.25 * 86400000);\n  if (cpYears > 21.01)\n    throw new Error('ergate: crediting period exceeds VMR0015 maximum of 21 years (got '+cpYears.toFixed(2)+')');\n  if (monDate && (monDate < cpStart || monDate > cpEnd))\n    throw new Error('ergate: monitoringPeriodEnd ('+monPeriodEnd+') outside crediting period');\n\n  // \u2500\u2500 PHASE 6: Audit log \u2500\u2500\n  var auditLog = {\n    evaluatedAt: d.calcedAt || monPeriodEnd,\n    mode: 'STRICT_INSTITUTIONAL',\n    valStatus: valStatus, verStatus: verStatus,\n    valIssuer: valIssuer, verIssuer: verIssuer, vvbIndependent: vvbIndependenceEnforced, dryRunMode: dryRunMode,\n    microSafetyConfirmed: microConfirmed, microSafetyMethod: wq.microSafetyMethod, microSafetyDate: wq.microSafetyDate,\n    ocConfirmed: oc.ownerConfirmation, confirmedAmount: confAmt,\n    creditingPeriodStart: reg.creditingPeriodStart, creditingPeriodEnd: reg.creditingPeriodEnd,\n    monitoringPeriodEnd: monPeriodEnd,\n    ERy: ERy, vcu: vcu, buffer: buf, bufferPct: d.bufferPctApplied,\n    methodologyCompliance: 'AMS_III_AV_v9_0_VMR0015_v1_0_STRICT'\n  };\n\n  return Object.assign({}, d, {\n    gateClearedAtMonitoringPeriodEnd: monPeriodEnd,\n    gateClearedAt: monPeriodEnd || (d.calcedAt || new Date().toISOString()),\n    gateVerdict: dryRunMode ? 'PASS_DRYRUN_VVB_INDEPENDENCE_SKIPPED' : 'PASS_INSTITUTIONAL',\n    selfAttestMode: false,\n    dryRunMode: dryRunMode,\n    methodologyCompliance: dryRunMode ? 'AMS_III_AV_v9_0_VMR0015_v1_0_DRYRUN' : 'AMS_III_AV_v9_0_VMR0015_v1_0_STRICT',\n    modeAuditLog: auditLog\n  });\n}\nreturn gate();",
                "outputSchema": "#4bb9c304-1bd0-49d7-81c8-ece542ae5a58",
                "documentSigner": "owner",
                "idType": "UUID",
