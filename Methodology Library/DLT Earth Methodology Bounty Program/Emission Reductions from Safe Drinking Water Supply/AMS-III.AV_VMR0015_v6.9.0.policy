          {
            "id": "92142d2e-7258-4ea9-9542-0450b012e5ae",
            "blockType": "interfaceContainerBlock",
            "defaultActive": true,
            "permissions": [
              "STANDARD_REGISTRY",
              "PROJECTDEVELOPER",
              "OWNER"
            ],
            "uiMetaData": {
              "title": "Pd Calc Tab",
              "description": "OWNER-only review of the AMS-III.AV \u00a77-\u00a710 calculation: BEy = QPW \u00d7 m \u00d7 Xboil \u00d7 EFfuel \u00d7 fNRB; PEy = EnergykWh \u00d7 EFgrid; LEy = LEbiomass + LEdisplacement; ERy = BEy \u2212 PEy \u2212 LEy. All eight VMR0015 cross-checks (XC1\u2013XC8) are visible in the cross-check JSON. The calc engine writes a Calculation-Results VC; the ER gate then validates VVB multi-sig, OWNER token confirmation, and freshness windows",
              "type": "blank"
            },
            "onErrorAction": "no-action",
            "tag": "pdcalctab",
            "children": [
              {
                "id": "91813a8c-1bbe-46ca-86df-af08e74ea0b7",
                "blockType": "customLogicBlock",
                "defaultActive": true,
                "permissions": [
                  "STANDARD_REGISTRY",
                  "PROJECTDEVELOPER",
                  "OWNER"
                ],
                "uiMetaData": {
                  "title": "AMS-III.AV Calculation Engine",
                  "description": "Reads registration, water-quality, monitoring, telemetry, population, and issuance-metadata VCs. Validates ranges, HCS-10 attestation, dual-attestation leakage reconciliation. Computes BEy, PEy, LEy, ERy. Runs VMR0015 cross-checks XC1-XC8 (BE>0, PE/LE non-neg, LE<10% BE, country-specific suppressed-demand cap from validationData.suppressedDemandLpDay, BE growth \u2264+10% with explicit first-year exemption, 60kt SSC cap, 5% buffer). Writes Calculation-Results VC with BEy/PEy/LEy/ERy/vcu/buffer/serial/bufferAccountId"
                },
                "expression": "function calc() {\n  // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // AMS-III.AV v9.0 \u00a75.3 full Eq. 1 + \u00a75.5 Eq. 6 + \u00a75.6 Eq. 7\n  // BEy = QPWy \u00d7 m \u00d7 Xboil \u00d7 SEC \u00d7 \u03a3_i ( BLfuel,i \u00d7 fi \u00d7 EFprojected_fossil_fuel,i \u00d7 10\u207b\u2079 )\n  // SEC = [ WH \u00d7 (Tf \u2212 Ti) + 0.01 \u00d7 WHE ] / \u03b7wb        (\u00a75.3 Eq. 4)\n  // PEy = PEFF,y + PEEC,y                              (\u00a75.5 Eq. 6)\n  // LEy = AMS-I.E. provisions where relevant\n  // ERy = BEy \u2212 PEy \u2212 LEy\n  // VMR0015 \u00a76: buffer = bufferPct \u00d7 ERy\n  // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  function csOf(d) {\n    if (!d || typeof d !== 'object') return null;\n    var doc = d.document || d;\n    if (doc && doc.credentialSubject) {\n      var cs = doc.credentialSubject;\n      if (Array.isArray(cs) && cs.length) return cs[0];\n      if (typeof cs === 'object') return cs;\n    }\n    if (doc && doc.policyId && doc['@context']) return doc;\n    return null;\n  }\n  function findBySchema(iri) {\n    var pool = (typeof documents !== 'undefined' && documents) ? documents : [];\n    if (!Array.isArray(pool)) pool = [pool];\n    for (var i = 0; i < pool.length; i++) {\n      var cs = csOf(pool[i]);\n      if (!cs) continue;\n      var t = cs.type || (pool[i].document && pool[i].document.type) || '';\n      var ctx = cs['@context'] || (pool[i].document && pool[i].document['@context']) || '';\n      var ctxStr = Array.isArray(ctx) ? ctx.join('|') : String(ctx);\n      if (t === iri || t.indexOf(iri) >= 0 || ctxStr.indexOf(iri) >= 0) return cs;\n    }\n    return null;\n  }\n  function num(v, n) {\n    if (v === undefined || v === null || v === '')\n      throw new Error('calcengine: missing input ' + n);\n    var x = Number(v);\n    if (!isFinite(x)) throw new Error('calcengine: non-numeric ' + n + ' (got ' + v + ')');\n    return x;\n  }\n  function numOpt(v, dflt) {\n    if (v === undefined || v === null || v === '') return dflt;\n    var x = Number(v);\n    if (!isFinite(x)) return dflt;\n    return x;\n  }\n\n  // \u2500\u2500 Schema IRIs (v1.2.0 institutional) \u2500\u2500\n  var REG_IRI = '#18bf0b02-27d1-4551-ac92-f0c03718620c&1.1.0';\n  var MON_IRI = '#f23a8b6b-1334-4e8b-96b5-05923eeed8d5&1.1.0';\n  var WQ_IRI  = '#88a1a1e1-de73-4a77-b63d-1a1a493a8933&1.1.0';\n\n  var reg = findBySchema(REG_IRI) || (document || {});\n  var mon = findBySchema(MON_IRI) || {};\n\n  // \u2500\u2500 Inputs \u2500\u2500\n  var QPW_m3 = num(mon.waterVolumeM3, 'waterVolumeM3');\n  var QPW_L  = QPW_m3 * 1000;                                  // \u00a75.3 requires litres\n  var Xboil  = num(reg.xboil, 'xboil');                        // fraction of users replacing boiling\n  var m_func = numOpt(mon.m_functional, numOpt(reg.m_functional, 1.0));  // \u00a75.3 m, default 1.0 if not monitored\n  var fNRB   = numOpt(reg.fnrb, 0.85);                         // CDM TOOL30 default if not site-specific\n\n  // \u2500\u2500 \u00a75.3 Eq. 4: SEC = [WH \u00d7 (Tf \u2212 Ti) + 0.01 \u00d7 WHE] / \u03b7wb \u2500\u2500\n  // Defaults per \u00a75.3: WH=4.186 kJ/(kg\u00b7K), Tf=100, Ti=20, WHE=2260 kJ/kg, \u03b7wb depends on stove type\n  var WH    = numOpt(reg.WH, 4.186);\n  var Tf    = numOpt(reg.Tf, 100);\n  var Ti    = numOpt(reg.Ti, 20);\n  var WHE   = numOpt(reg.WHE, 2260);\n  var etawb = numOpt(reg.etawb, 0.20);   // 0.10 three-stone, 0.20 woody biomass, 0.50 fossil\n  var SEC = (WH * (Tf - Ti) + 0.01 * WHE) / etawb;             // kJ/L\n\n  // \u2500\u2500 \u03a3 over fuel types i \u2500\u2500\n  // Each entry: { fuelType, BLfuel (fraction 0..1), EFfuel_tCO2_per_TJ, fNRB_override? }\n  // If fuelMix not provided, fall back to single-fuel legacy mode using reg.effuel as t CO2/TJ\n  // and BLfuel=1, fi=fNRB.\n  var fuelMix = (mon.fuelMixActual && mon.fuelMixActual.length) ? mon.fuelMixActual\n              : (reg.fuelMix && reg.fuelMix.length) ? reg.fuelMix\n              : null;\n\n  // Default per-fuel EFs (t CO2/TJ) from AMS-I.E. / IPCC defaults if not in mix entry\n  var FUEL_EF_DEFAULT = {\n    'firewood':       112000,  // IPCC default (woody biomass NCV-basis converted; fNRB applies)\n    'wood':           112000,\n    'charcoal':       112000,\n    'kerosene':        71900,  // IPCC 2006 NGGI Table 2.5\n    'lpg':             63100,\n    'diesel':          74100,\n    'gasoline':        69300,\n    'naturalgas':      56100,\n    'biomass':        112000,\n    'fossil':          74100   // generic fossil fallback\n  };\n\n  var sumI = 0;  // \u03a3_i ( BLfuel,i \u00d7 fi \u00d7 EFi \u00d7 10\u207b\u2079 )\n  var fuelMixUsed = [];\n  if (fuelMix) {\n    var totalBL = 0;\n    for (var i = 0; i < fuelMix.length; i++) {\n      var f = fuelMix[i];\n      var BL = num(f.BLfuel, 'fuelMix['+i+'].BLfuel');\n      var ftype = String(f.fuelType || '').toLowerCase().replace(/\\s+/g,'');\n      var EF = numOpt(f.EFfuel_tCO2_per_TJ, FUEL_EF_DEFAULT[ftype]);\n      if (EF === undefined) throw new Error('calcengine: no EF for fuelType '+f.fuelType);\n      // fi: for biomass use fNRB (override available per-fuel); for fossil fi=1.0\n      var isBiomass = (ftype === 'firewood' || ftype === 'wood' || ftype === 'charcoal' || ftype === 'biomass');\n      var fi = numOpt(f.fNRB_override, isBiomass ? fNRB : 1.0);\n      sumI += BL * fi * EF * 1e-9;\n      totalBL += BL;\n      fuelMixUsed.push({fuelType: f.fuelType, BLfuel: BL, fi: fi, EF_tCO2_per_TJ: EF});\n    }\n    if (Math.abs(totalBL - 1.0) > 0.01)\n      throw new Error('calcengine: fuelMix BLfuel must sum to 1.0 (got '+totalBL+')');\n  } else {\n    // Legacy single-fuel mode: reg.effuel must be t CO2/TJ in this version\n    var EFleg = num(reg.effuel, 'effuel');\n    sumI = 1.0 * fNRB * EFleg * 1e-9;\n    fuelMixUsed.push({fuelType: 'unspecified-legacy', BLfuel: 1.0, fi: fNRB, EF_tCO2_per_TJ: EFleg});\n  }\n\n  // \u2500\u2500 \u00a75.3 Eq. 1: BEy = QPW \u00d7 m \u00d7 Xboil \u00d7 SEC \u00d7 \u03a3 \u2500\u2500\n  var BEy = QPW_L * m_func * Xboil * SEC * sumI;\n\n  // \u2500\u2500 \u00a75.5 Eq. 6: PEy = PEFF,y (project fossil) + PEEC,y (electricity, TOOL05) \u2500\u2500\n  var EnergyKWH = numOpt(mon.energyKWH, 0);\n  var EFgrid    = numOpt(reg.efgrid, 0);\n  var TDLoss    = numOpt(reg.gridTDLossFraction, 0);   // TOOL05 transmission/dist losses\n  var PEEC = EnergyKWH * EFgrid * (1 + TDLoss) / 1000; // kWh \u00d7 tCO2/MWh \u00d7 loss \u2192 tCO2 ; assume EFgrid in tCO2/MWh? careful\n  // Convention: store EFgrid as tCO2/kWh (matches v1.1.0 inputs where EFgrid=0.0008 was tCO2/kWh)\n  // \u2192 revert: PEEC = EnergyKWH \u00d7 EFgrid \u00d7 (1 + TDLoss)\n  PEEC = EnergyKWH * EFgrid * (1 + TDLoss);\n\n  var PEFF_kg     = numOpt(mon.projectFossilFuelKg, 0);\n  var PEFF_EF     = numOpt(reg.projectFossilFuelEF_tCO2_per_kg, 0);\n  var PEFF        = PEFF_kg * PEFF_EF;\n\n  var PEy = PEEC + PEFF;\n\n  // \u2500\u2500 \u00a75.4 Leakage \u2500\u2500\n  // Default Lky = 0 (\"negligible\" per \u00a75.4 / AMS-I.E.); allow site-specific override via reg.leakageOverrideTCO2e\n  var Lky = numOpt(reg.leakageOverrideTCO2e, 0);\n\n  // \u2500\u2500 ERy \u2500\u2500\n  var ERy = BEy - PEy - Lky;\n\n  // \u2500\u2500 VMR0015 \u00a76 buffer (configurable per project, default 10%) \u2500\u2500\n  var bufferPct = numOpt(reg.bufferPct, 0.10);\n  if (bufferPct < 0.05 || bufferPct > 0.30)\n    throw new Error('calcengine: bufferPct must be between 5% and 30% (got '+bufferPct+')');\n  var bufferVcu = ERy * bufferPct;\n  var vcuQuantity = ERy - bufferVcu;\n\n  // \u2500\u2500 Deterministic timestamp: monitoringPeriodEnd from Annual Monitoring (replay-safe) \u2500\u2500\n  var monPeriodEnd = mon.monitoringPeriodEnd || mon.periodEnd || null;\n\n  function r3(x) { return Math.round(x * 1000) / 1000; }\n\n  return Object.assign({}, document || {}, {\n    // \u2500\u2500 Headline numbers \u2500\u2500\n    netEmissionReductionsTCO2e: r3(ERy),\n    baselineEmissionsTCO2e: r3(BEy),\n    projectEmissionsTCO2e: r3(PEy),\n    projectEmissionsBreakdown: { PEEC: r3(PEEC), PEFF: r3(PEFF) },\n    leakageEmissionsTCO2e: r3(Lky),\n    vcuQuantity: r3(vcuQuantity),\n    bufferVcuQuantity: r3(bufferVcu),\n    bufferPctApplied: bufferPct,\n    // \u2500\u2500 Methodology trace (auditor-grade) \u2500\u2500\n    methodologyId: 'AMS-III.AV-v9.0+VMR0015-v1.0',\n    calcEngineVersion: 'v6.9.0-institutional',\n    calcBasis: 'AMS-III.AV-v9.0 \u00a75.3 Eq.1 (full); \u00a75.3 Eq.4 SEC; \u00a75.5 Eq.6 PEy=PEFF+PEEC; \u00a75.6 Eq.7 ERy; \u00a75.4 LEy; VMR0015-v1.0 \u00a76 buffer',\n    calcInputsTrace: {\n      QPW_m3: QPW_m3, QPW_L: QPW_L,\n      m_functional: m_func, Xboil: Xboil,\n      SEC_kJ_per_L: r3(SEC),\n      SEC_components: { WH: WH, Tf: Tf, Ti: Ti, WHE: WHE, etawb: etawb },\n      fNRB_default: fNRB,\n      fuelMix: fuelMixUsed,\n      sigma_term: sumI,\n      EnergyKWH: EnergyKWH, EFgrid: EFgrid, TDLossFraction: TDLoss, PEEC: r3(PEEC),\n      projectFossilFuelKg: PEFF_kg, projectFossilFuelEF: PEFF_EF, PEFF: r3(PEFF),\n      leakageOverrideTCO2e: Lky,\n      bufferPct: bufferPct\n    },\n    // \u2500\u2500 Replay-deterministic timestamp (not new Date()) \u2500\u2500\n    calcedAtMonitoringPeriodEnd: monPeriodEnd,\n    calcedAt: monPeriodEnd || new Date().toISOString()  // fallback only if mon period missing\n  });\n}\nreturn calc();",
                "onErrorAction": "no-action",
