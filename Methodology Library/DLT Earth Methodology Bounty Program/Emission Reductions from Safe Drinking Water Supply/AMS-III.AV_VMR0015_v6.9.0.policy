                  "NO_ROLE"
                ],
                "uiMetaData": {
                  "title": "Registration Returned for Correction",
                  "description": "The Standard Registry or VVB has flagged the project registration for correction. Review the registration-review notes, edit the original Project-Registration VC fields (fractionboiling, xboil, effuel, efgrid, project boundary, additionality declaration), and resubmit. The original messageId remains anchored on topic 0.0.8838546 for full audit history"
                },
                "tag": "regrejectinfo",
                "children": [],
                "events": [
                  {
                    "source": "regreviewswitch",
