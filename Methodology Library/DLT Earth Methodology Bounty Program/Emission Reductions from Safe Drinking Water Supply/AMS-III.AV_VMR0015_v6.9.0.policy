                "permissions": [
                  "STANDARD_REGISTRY",
                  "VVB",
                  "OWNER"
                ],
                "uiMetaData": {
                  "title": "Registration Review Switch",
                  "description": "Routes registration outcome: approve continues to validation stage; reject returns the developer to a corrections informationBlock with a resubmit affordance under the same projectId. Implements \u00a711 corrective-action loop at the registration stage"
                },
                "conditions": [
                  {
                    "type": "equal",
                    "value": "option.status === 'reject'",
                    "actor": "owner",
                    "tag": "reg_reject_event"
                  },
                  {
                    "type": "equal",
                    "value": "option.status === 'approve'",
                    "actor": "owner",
                    "tag": "kyc_approve_event"
                  }
                ],
                "executionFlow": "firstTrue",
                "tag": "regreviewswitch",
                "children": [],
                "events": [],
                "artifacts": []
              },
              {
                "id": "128b6755-2b6d-4767-b157-fc801eb1517e",
