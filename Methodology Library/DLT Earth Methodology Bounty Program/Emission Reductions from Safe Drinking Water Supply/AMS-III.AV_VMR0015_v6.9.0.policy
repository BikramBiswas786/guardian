                  "OWNER"
                ],
                "uiMetaData": {
                  "title": "Grant KYC: VCU-SDW",
                  "description": "Grants Hedera KYC status on the VCU-SDW token to the project developer's account so that subsequent mints will be accepted. Required because the token has enableKYC=true. Without this, TokenMint would fail with ACCOUNT_KYC_NOT_GRANTED_FOR_TOKEN"
                },
                "action": "grantKyc",
                "useTemplate": true,
